{
  "name": "mern-hospital-app",
  "private": true,
  "type": "module",
  "scripts": {
    "client": "npm run dev --prefix Frontend",
    "server": "npm run dev --prefix Backend",
    "dev": "concurrently -k -n SERVER,CLIENT -c green,blue \"npm run server\" \"npm run client\"",
    "test": "npm test --prefix Backend && npm test --prefix Frontend",
    "lint": "npm run lint --prefix Frontend",
    "seed": "npm run seed --prefix Backend",
    "build:pages": "npm run build:pages --prefix Frontend",
    "build": "npm run build --prefix Frontend"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "shell-quote": "^1.12.0"
  }
}
