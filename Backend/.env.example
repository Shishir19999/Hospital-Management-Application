# MongoDB connection string
MONGODB_URL=mongodb://127.0.0.1:27017/hospital
# Port the API listens on (default 8080, matches the frontend default)
PORT=8080
# Required: long random string used to sign login tokens
JWT_SECRET=REPLACE_ME
# Token lifetime (default 1d)
JWT_EXPIRE=1d

# Comma-separated browser origins allowed by CORS (unset = any origin). Add your LAN origin, e.g. http://192.168.1.79:5173
CORS_ORIGIN=
# Bind address (default 0.0.0.0, reachable from the LAN)
HOST=0.0.0.0

# Rate limits (optional): requests per minute per address, and failed sign-ins before a temporary block
RATE_LIMIT_PER_MINUTE=600
LOGIN_MAX_FAILURES=10
